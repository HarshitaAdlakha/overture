# Copy to .env and fill in. Never commit .env.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=https://<ref>.supabase.co
# Shared secret for admin-only actions (seeding, eval). Set the same value with `supabase secrets set`.
OV_ADMIN_SECRET=
# Edge-function secrets (set with `npx supabase secrets set ...`, not here):
#   OPENAI_API_KEY     (optional; templates without)
#   OV_MODEL           (optional override, default gpt-5-mini)
